# Disk layout, applied by nixos-anywhere through disko: it wipes the skeleton
# VM's disk and partitions it like this. On Proxmox the first SCSI disk
# (interface = "scsi0" with the default virtio-scsi controller) is /dev/sda.
{
  disko.devices.disk.main = {
    device = "/dev/sda";
    type = "disk";
    content = {
      type = "gpt";
      partitions = {
        ESP = {
          type = "EF00";
          size = "512M";
          content = {
            type = "filesystem";
            format = "vfat";
            mountpoint = "/boot";
            mountOptions = [ "umask=0077" ];
          };
        };
        root = {
          size = "100%";
          content = {
            type = "filesystem";
            format = "ext4";
            mountpoint = "/";
          };
        };
      };
    };
  };
}
